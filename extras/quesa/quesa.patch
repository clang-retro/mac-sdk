 #elif QUESA_OS_MACINTOSH && !QUESA_UH_IN_FRAMEWORKS
 	
 	#include <CFString.h>
@@ -499,6 +503,36 @@ void*	GLGetProcAddress( const char* funcName )
 	return (void*)glXGetProcAddressARB( (const GLubyte*)funcName );
 }
 
+#elif QUESA_OS_MACINTOSH && !QUESA_UH_IN_FRAMEWORKS && !TARGET_API_MAC_CARBON
+
+// Finds a function of OpenGLLibrary by name, through the Code Fragment
+// Manager. Gives NULL when the library or the function is not there.
+void*	GLGetProcAddress( const char* funcName )
+{
+	static CFragConnectionID	sConn = NULL;
+	static bool					sTried = false;
+	if (!sTried)
+	{
+		sTried = true;
+		Ptr		entry = NULL;
+		Str255	err;
+		if (GetSharedLibrary( "\pOpenGLLibrary", kPowerPCCFragArch, kReferenceCFrag,
+			&sConn, &entry, err ) != noErr)
+			sConn = NULL;
+	}
+	size_t	len = (funcName != NULL) ? strlen( funcName ) : 0;
+	if ((sConn == NULL) || (len == 0) || (len > 255))
+		return NULL;
+	Str255	pName;
+	pName[0] = (unsigned char) len;
+	memcpy( pName + 1, funcName, len );
+	Ptr			addr = NULL;
+	CFragSymbolClass	symClass = 0;
+	if (FindSymbol( sConn, pName, &addr, &symClass ) != noErr)
+		return NULL;
+	return addr;
+}
+
 #elif QUESA_OS_MACINTOSH && !QUESA_UH_IN_FRAMEWORKS
 
 
